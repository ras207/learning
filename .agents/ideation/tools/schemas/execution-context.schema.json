{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ras207:learning:ideation:execution-context:1",
  "title": "Ideation trusted execution context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","trust_mode","run_id","actor","project_id","project_slug","iteration","authorized_ref","expected_head_sha","content_store_root","policy_version","human_authorizations"],
  "properties": {
    "schema_version": {"const": 1},
    "trust_mode": {"enum": ["local_harness"]},
    "run_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "iteration": {"type": "integer", "minimum": 1},
    "authorized_ref": {"type": "string", "pattern": "^refs/heads/.+"},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "content_store_root": {"type": "string", "minLength": 1},
    "policy_version": {"const": 1},
    "human_authorizations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["authorization_id","project_id","iteration","transaction_id","action_hash","actor","issued_at"],
        "properties": {
          "authorization_id": {"type": "string", "minLength": 1},
          "project_id": {"type": "string", "minLength": 1},
          "iteration": {"type": "integer", "minimum": 1},
          "transaction_id": {"type": "string", "minLength": 1},
          "action_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "actor": {"type": "string", "minLength": 1},
          "issued_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
