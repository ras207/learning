{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ras207:learning:ideation:approvers:1",
  "title": "Ideation human approvers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rp_id", "origin", "approval_page_url", "approvers"],
  "properties": {
    "schema_version": {"const": 1},
    "rp_id": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "pattern": "^https?://[^/]+$"},
    "approval_page_url": {"type": "string", "pattern": "^https?://"},
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver", "credential_id", "public_key_spki", "algorithm", "fingerprint", "added_at"],
        "properties": {
          "approver": {"type": "string", "minLength": 1},
          "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "public_key_spki": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "algorithm": {"const": -7},
          "fingerprint": {"type": "string", "pattern": "^[0-9A-F]{4}(-[0-9A-F]{4}){3}$"},
          "added_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
