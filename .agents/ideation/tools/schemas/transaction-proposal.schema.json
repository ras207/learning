{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ras207:learning:ideation:transaction-proposal:1",
  "title": "Ideation normalized transaction proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","transaction_id","source","project","expected_revision","state_mutations","artifact_changes","summary"],
  "properties": {
    "schema_version": {"const": 1},
    "transaction_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind","source_id"],
      "properties": {
        "kind": {"enum": ["skill_result","workflow_operation","state_migration"]},
        "source_id": {"type": "string", "minLength": 1},
        "skill_id": {"type": ["string","null"]},
        "source_hash": {"type": ["string","null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id","project_slug","iteration"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "project_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "iteration": {"type": "integer", "minimum": 1}
      }
    },
    "expected_revision": {"type": "integer", "minimum": 0},
    "state_mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
    "artifact_changes": {"type": "array", "items": {"$ref": "#/$defs/artifactChange"}},
    "summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation","section","record_id","patch","rationale","dependencies","authorization_id"],
      "properties": {
        "operation": {"enum": ["initialize","create","update","resolve","supersede","invalidate","reconfirm","checkpoint","finalize_approved","finalize_not_progressing","reopen_iteration","migrate"]},
        "section": {"enum": ["project","workflow","session","routing","artifacts","decisions","assumptions","work_items","evidence","gate_evaluations","finalization","history"]},
        "record_id": {"type": ["string","null"]},
        "patch": {"type": "object"},
        "rationale": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authorization_id": {"type": ["string","null"]}
      }
    },
    "artifactChange": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id","path","operation","content_ref","expected_fingerprint","role","status","rationale"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^projects/[^/]+/ideation/"},
        "operation": {"enum": ["create","update"]},
        "content_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_fingerprint": {"type": ["string","null"], "pattern": "^(?:[0-9a-f]{64})?$"},
        "role": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
